# Regenerate with `just gen-diagrams`.
direction: right
registry: "Tools" {
  local: "local tools" {style.fill: "#ffe8d6"; style.font-color: "#1f2328"}
  mcp: "MCP server tools" {style.fill: "#ffe8d6"; style.font-color: "#1f2328"}
  output: "output= tool (submit)" {style.fill: "#ffe8d6"; style.font-color: "#1f2328"}
}
request: "Request sent each round" {
  history: "system + history"
  full: "every tool definition, in full" {style.fill: "#ffe8d6"; style.font-color: "#1f2328"}
}
model: Model {shape: circle}
registry.local -> request.full
registry.mcp -> request.full
registry.output -> request.full
request -> model: every round
