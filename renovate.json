{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>polarsen-io/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Library: keep the widest supported requires-python",
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "xai-sdk 1.21 needs packaging<26; commitizen 4.19.3 needs packaging>=26",
      "matchPackageNames": [
        "commitizen"
      ],
      "allowedVersions": "<4.19.3"
    }
  ]
}
